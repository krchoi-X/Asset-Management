generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Holding {
  id            Int     @id @default(autoincrement())
  ticker        String  @unique
  name          String?
  shares        Float
  buy_price     Float
  current_price Float
  sector        String?
  country       String?
  themes        String
  notes         String?
}
